[Desktop Entry]
Version=1.0
Type=Application
Name=Paper Trading starten
Comment=Startet den Paper-Trading-Bot und öffnet das Dashboard (PAPER ONLY)
# Besser: ./install_desktop_icon.sh — setzt absolute Pfade auf dem Desktop
Exec=bash -lc 'cd "$(dirname "$1")" && ./start_paper_trading.sh' dummy %k
Icon=assets/paper-trading-icon.png
Terminal=true
Categories=Finance;Utility;
StartupNotify=true
